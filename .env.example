# База данных PostgreSQL (на Railway: ${{Postgres.DATABASE_URL}}). Без неё сайт работает, но вход и сохранение недоступны.
DATABASE_URL=postgresql://user:pass@localhost:5432/ufdepot
# Вход только через Telegram Login Widget. Токен бота от @BotFather — секрет, задаётся только в переменных окружения.
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например UFDepotBot. Домен сайта привязывается в @BotFather командой /setdomain.
TELEGRAM_BOT_USERNAME=
